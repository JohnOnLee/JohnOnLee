{{- /* One flat sitemap at /sitemap.xml instead of Hugo's default index.

     The default splits into /ko/sitemap.xml and /en/sitemap.xml. Korean pages
     live at the root (defaultContentLanguageInSubdir: false), so the Korean
     sitemap sat at /ko/ while listing URLs at /, /blog/, /brief/ — outside its
     own directory, which the sitemaps.org protocol does not allow. Serving
     every URL from the root sitemap keeps each listing inside the file's own
     path and drops the extra fetch.

     Overriding sitemapindex.xml (not sitemap.xml) is what replaces the index
     itself. The context is the list of sites, one per language.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range . }}
    {{- range .Pages }}
      {{- if not .Sitemap.Disable }}
  <url>
    <loc>{{ .Permalink }}</loc>
        {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
        {{- end }}
        {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
        {{- end }}
        {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
        {{- end }}
        {{- if .IsTranslated }}
          {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}"/>
          {{- end }}
        {{- end }}
  </url>
      {{- end }}
    {{- end }}
  {{- end }}
</urlset>
